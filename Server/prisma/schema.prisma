generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoomRole {
  OWNER
  MEMBER
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model User {
  // Clerk supplies this ID after authentication.
  id          String   @id
  displayName String?
  createdAt   DateTime @default(now())

  roomsCreated Room[]       @relation("RoomCreator")
  memberships  RoomMember[]
  messages     Message[]
  joinRequests RoomJoinRequest[] @relation("JoinRequester")
  decisions    RoomJoinRequest[] @relation("JoinDecider")
}

model Room {
  id          String   @id @default(uuid())
  name        String
  createdById String
  inviteToken String?  @unique
  inviteCode  String?  @unique
  avatarKey   String?
  avatarUpdatedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  createdBy User         @relation("RoomCreator", fields: [createdById], references: [id], onDelete: Restrict)
  members   RoomMember[]
  messages  Message[]
  joinRequests RoomJoinRequest[]
}

model RoomJoinRequest {
  id          String @id @default(uuid())
  roomId      String
  userId      String
  status      JoinRequestStatus @default(PENDING)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  decidedAt   DateTime?
  decidedById String?
  room        Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user        User @relation("JoinRequester", fields: [userId], references: [id], onDelete: Cascade)
  decidedBy   User? @relation("JoinDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@unique([roomId, userId])
  @@index([roomId, status, createdAt, id])
  @@index([userId, status])
}

model RoomMember {
  roomId   String
  userId   String
  role     RoomRole @default(MEMBER)
  joinedAt DateTime @default(now())

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([roomId, userId])
  @@index([userId])
}

model Message {
  voiceKey String?
  voiceMime String?
  voiceDurationMs Int?
  id        String   @id @default(uuid())
  roomId    String
  authorId  String
  body      String   @db.Text
  createdAt DateTime @default(now())

  room   Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([roomId, createdAt, id])
  @@index([authorId])
}
